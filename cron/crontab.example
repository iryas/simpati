# ============================================================
#  SIMPATI — Contoh crontab (jadwal tugas otomatis)
# ============================================================
#  Cara pasang di SERVER:
#    1) Ganti  /path/ke/kahfinet1  dengan path aplikasi di server-mu
#       (cek dengan: pwd  saat berada di folder aplikasi).
#    2) Ganti  php  dengan path lengkap bila perlu (cek: which php).
#       Di shared hosting sering: /usr/bin/php  atau  /usr/local/bin/php
#    3) Pasang:  crontab -e   lalu tempel baris di bawah,
#       ATAU sekaligus:  crontab /path/ke/kahfinet1/cron/crontab.example
#    4) Cek terpasang:  crontab -l
#
#  Catatan:
#    - "cd ... &&" dipakai agar file log tertulis ke folder logs/ aplikasi.
#    - wa:work & usage:work (mode loop) BUKAN untuk cron — itu proses
#      persisten (jalankan via systemd / nohup / screen). Lihat bawah.
# ============================================================

# ── Polling pemakaian PPPoE (byte-out + uptime) — tiap 5 menit ──
#    Ini yang mengisi grafik "Pemakaian" di Portal Pelanggan.
#    Makin sering = makin akurat saat pelanggan reconnect (boleh */1 atau */3).
*/5 * * * * cd /path/ke/kahfinet1 && php worker.php usage:poll >> logs/usage_poll.log 2>&1

# ── Sync cache ONU dari GenieACS (Monitoring) — tiap 1 menit ──
#    Menyegarkan status/RXPower/suhu/WiFi ONU untuk area Monitoring.
#    Default 1 menit; boleh diperlama (*/2 atau */3) — ONU lapor tiap ~100 detik.
*/1 * * * * cd /path/ke/kahfinet1 && php worker.php acs:sync >> logs/acs_sync.log 2>&1

# ── Auto-isolir pelanggan menunggak — tiap hari jam 01:00 ──
0 1 * * * cd /path/ke/kahfinet1 && php cron/isolir_check.php >> logs/isolir_cron.log 2>&1

# ============================================================
#  Contoh nyata (dev/lokal) — sesuaikan untuk server:
#    */5 * * * * cd /Users/macbook/Program/php/kahfinet1 && /opt/homebrew/bin/php worker.php usage:poll >> logs/usage_poll.log 2>&1
#
#  Alternatif TANPA cron (proses loop) — jalankan & jaga tetap hidup:
#    nohup php worker.php usage:work 1 >> logs/usage_poll.log 2>&1 &   # pemakaian, loop tiap 1 menit
#    nohup php worker.php acs:work 1   >> logs/acs_sync.log   2>&1 &   # sync ONU, loop tiap 1 menit
#    nohup php worker.php wa:work        >> logs/wa_worker.log  2>&1 &   # antrian WhatsApp
# ============================================================
